# Copy this file to .env.local (same directory) and fill in the values you
# actually use. .env.local is git-ignored; this template is not.
#
# The harness reads the LLM_* trio only when you run with --agent llm. Anything
# already exported in your shell takes precedence over what is written here.
#
# Any OpenAI-compatible endpoint works. Three common shapes:

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- local vLLM / Ollama (no key needed) ---
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
