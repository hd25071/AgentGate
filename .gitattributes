# Normalize every text file to LF in the repository and check it out as LF on
# every platform.
#
# Without this, core.autocrlf=true (the default on Windows) rewrites each file
# on the way out. That produces noisy diffs, and it silently puts CR characters
# into files whose consumers do not expect them -- Rego bundles, YAML manifests,
# and the Python evaluation harness.
* text=auto eol=lf

# Windows-only scripting keeps CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF even when checked out on Windows; a CR in the
# shebang line breaks them.
*.sh text eol=lf

# Binary assets are never inspected or converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
