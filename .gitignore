# --- build output ---------------------------------------------------------
/bin/
/dist/
*.exe
*.exe~
*.test
*.out

# --- local runtime state --------------------------------------------------
/data/
/var/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
_smoke/

# --- secrets --------------------------------------------------------------
# .env.example is committed; anything you actually fill in is not.
.env
.env.local
.env.*.local

# --- evaluation artefacts -------------------------------------------------
# The harness writes these on every run. The frozen reports are committed on
# purpose so the numbers in the README can be checked without rerunning: the
# current one, the one from before a policy change (so a before/after claim is
# checkable rather than taken on trust), and the comparison between them.
# Everything else -- the .json in particular, which carries every sample -- is
# regenerated and is not worth 100KB of history per run.
eval/report/*.json
eval/report/*.md
!eval/report/report.md
!eval/report/report-v1.md
!eval/report/report-llm.md
!eval/report/compare.md

# --- tooling / editor -----------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.idea/
.vscode/

# --- agent workspace ------------------------------------------------------
# Local working notes for the development agent. Not part of the product.
.workbuddy/

# --- OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- scratch --------------------------------------------------------------
# Ad-hoc probes written to the repo root during debugging.
_*.log
_*.txt
