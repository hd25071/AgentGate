# Copy to .env and replace both secrets. Never commit the result.
#
#   agentgate-cli token secret
#
AG_TOKEN_SECRET=change-me-at-least-16-bytes-long
AG_ADMIN_TOKEN=change-me-too-at-least-16-bytes

# Declared environment of the targets. Policy treats "prod" differently: every
# write, delete, config change, exec and scale needs a human, and an
# irreversible one -- or a delete at namespace / cluster / dataset / site scope
# -- needs two. A few rules refuse outright, but only against production:
# scaling a workload to zero, KEYS *, and shutting a device interface.
AG_ENV=staging

# --- storage -------------------------------------------------------------
# sqlite (default, single node) or postgres
AG_STORE_DRIVER=postgres
AG_STORE_DSN=postgres://agentgate:agentgate@postgres:5432/agentgate?sslmode=disable

# --- policy --------------------------------------------------------------
# Leave empty to use the bundle embedded in the binary.
AG_POLICY_DIR=

# --- approvals -----------------------------------------------------------
AG_APPROVAL_TTL=30m
# Optional: post a card to a chat tool. Shape is "generic" or "feishu".
AG_APPROVAL_WEBHOOK_URL=
AG_APPROVAL_WEBHOOK_SHAPE=feishu

# --- targets -------------------------------------------------------------
AG_REDIS_NAME=redis-primary
AG_REDIS_ADDR=redis:6379
AG_REDIS_PASSWORD=

# mock   = in-memory simulator (no cluster needed, used by the demo and eval)
# cluster = talk to a real API server
AG_K8S_MODE=mock
AG_K8S_NAME=k8s-cluster
# AG_K8S_SERVER=https://127.0.0.1:6443
# AG_K8S_TOKEN=
# AG_K8S_KUBECONFIG=/home/you/.kube/config
AG_K8S_INSECURE=false

AG_VRP_NAME=vrp-edge-1
AG_VRP_MODE=simulator

# --- preview -------------------------------------------------------------
# Without this, network changes get the local heuristic, clearly labelled.
AG_NETGUARD_URL=

# --- tracing -------------------------------------------------------------
AG_OTEL_ENDPOINT=
AG_OTEL_INSECURE=true
AG_OTEL_SAMPLE=1
AG_LOG_FORMAT=text
